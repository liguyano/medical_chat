{
  "id": "admission_assessment",
  "title": "入院评估单",
  "source_file": "docs/文档/评估表/入院评估单.pdf",
  "status": "pending_review",
  "form_type": "assessment_form",
  "extraction_method": "visual_review_from_rendered_pdf",
  "patient_header_fields": ["ward", "patient_name", "bed_no", "inpatient_no"],
  "sections": [
    {
      "id": "basic_information",
      "title": "基本情况",
      "fields": [
        {"id": "sex", "label": "性别", "type": "text"},
        {"id": "age", "label": "年龄", "type": "integer"},
        {"id": "occupation", "label": "职业", "type": "text"},
        {"id": "marital_status", "label": "婚姻", "type": "single_choice", "options": ["未婚", "已婚", "离婚", "未说明婚姻情况"]},
        {"id": "religion", "label": "宗教", "type": "single_choice_with_other", "options": ["无", "天主教", "基督教", "伊斯兰教", "佛教", "道教", "其它"]},
        {"id": "education", "label": "教育程度", "type": "single_choice", "options": ["文盲", "小学", "初中", "高中", "中专", "大专", "本科", "硕士", "博士"]},
        {"id": "information_source", "label": "资料来源", "type": "multiple_choice", "options": ["患者", "外院", "父亲", "母亲", "父母", "家属", "朋友", "保姆", "医护人员", "其它亲属或法定监护人", "其它"]},
        {"id": "admission_method", "label": "入院方式", "type": "multiple_choice", "options": ["急诊", "平诊", "步行", "扶行", "轮椅", "抱入", "手抱", "平车", "车床", "担架", "转运", "本院产科", "其它"]},
        {"id": "accompanying_person", "label": "陪同人", "type": "multiple_choice", "options": ["无", "外院", "父亲", "母亲", "父母", "家属", "朋友", "保姆", "医护人员", "其它亲属或法定监护人", "其它"]},
        {"id": "daily_caregiver", "label": "日常照顾者", "type": "multiple_choice", "options": ["自我照顾", "配偶", "子女", "父母", "保姆", "朋友", "亲戚", "其它"]},
        {"id": "diagnosis", "label": "诊断", "type": "long_text"}
      ]
    },
    {
      "id": "nursing_assessment",
      "title": "护理评估",
      "fields": [
        {"id": "temperature", "label": "体温T", "type": "decimal", "unit": "℃"},
        {"id": "pulse", "label": "脉搏P", "type": "integer", "unit": "次/分"},
        {"id": "respiration", "label": "呼吸R", "type": "integer", "unit": "次/分"},
        {"id": "blood_pressure", "label": "血压Bp", "type": "blood_pressure", "unit": "mmHg"},
        {"id": "height_cm", "label": "身高", "type": "decimal", "unit": "cm"},
        {"id": "weight_kg", "label": "体重", "type": "decimal", "unit": "kg"},
        {"id": "bmi", "label": "BMI", "type": "decimal"},
        {"id": "allergy_history", "label": "过敏史", "type": "boolean_with_detail"},
        {"id": "past_history", "label": "既往史", "type": "multiple_choice", "options": ["无", "有", "糖尿病", "高血压", "哮喘", "消化性溃疡", "其他"]},
        {"id": "consciousness", "label": "意识状态", "type": "grouped_choice", "groups": [{"label": "呼之", "options": ["能应", "不应"]}, {"label": "对答", "options": ["切题", "不切题"]}, {"label": "其他", "type": "text"}]},
        {"id": "language_expression", "label": "语言表达", "type": "single_choice_with_other", "options": ["清楚", "含糊", "失语", "其他"]},
        {"id": "diet", "label": "饮食", "type": "multiple_choice", "options": ["自行进食", "协助进食", "经鼻胃管", "经鼻肠管", "经胃肠造瘘管", "禁食"]},
        {"id": "oral_mucosa", "label": "口腔黏膜", "type": "multiple_choice", "options": ["完整", "溃疡", "白斑", "红肿", "其他"]},
        {"id": "swallowing_difficulty", "label": "吞咽困难", "type": "single_choice_with_other", "options": ["无", "有", "其他"]},
        {"id": "sleep", "label": "睡眠", "type": "multiple_choice", "options": ["正常", "难入睡", "早醒", "易醒", "昼夜颠倒", "需辅助药物", "其他"]},
        {"id": "defecation", "label": "大便", "type": "multiple_choice", "options": ["正常", "便秘", "腹泻", "失禁", "其他"]},
        {"id": "urination", "label": "小便", "type": "multiple_choice", "options": ["正常", "尿频", "尿急", "尿痛", "血尿", "多尿", "少尿", "尿潴留", "尿失禁", "留置尿管", "无尿", "夜尿多"]},
        {"id": "limb_activity", "label": "四肢活动", "type": "multiple_choice", "options": ["自如", "乏力", "偏瘫（左上肢）", "偏瘫（左下肢）", "偏瘫（右上肢）", "偏瘫（右下肢）", "截瘫", "全瘫", "活动受限", "其他"]},
        {"id": "self_care_ability", "label": "自理能力", "type": "single_choice", "options": ["完全自理", "部分自理", "完全不能自理"]},
        {"id": "skin_condition", "label": "皮肤状况", "type": "multiple_choice", "options": ["完整", "苍白", "黄疸", "潮红", "紫绀", "干燥", "出血点", "压疮", "破损", "水肿", "皮疹", "其他"]},
        {"id": "smoking", "label": "嗜好-吸烟", "type": "boolean_with_quantity", "unit": "支/天"},
        {"id": "drinking", "label": "嗜好-嗜酒", "type": "boolean_with_quantity", "unit": "g/日"},
        {"id": "drug_dependence", "label": "药物依赖", "type": "boolean_with_detail"},
        {"id": "other_nursing_assessment", "label": "其它", "type": "long_text"}
      ]
    },
    {
      "id": "scale_summary",
      "title": "量表评估情况",
      "fields": [
        {"id": "adl_score", "label": "ADL评分", "type": "integer", "notify_doctor_condition": "总分<=40分"},
        {"id": "fall_score", "label": "跌倒评分", "type": "integer", "notify_doctor_condition": "总分>=40分"},
        {"id": "pressure_injury_score", "label": "压疮评分", "type": "integer", "notify_doctor_condition": "总分<=12分"},
        {"id": "pain_score", "label": "疼痛评分", "type": "integer", "notify_doctor_condition": "总分>=4分"},
        {"id": "nutrition_score", "label": "营养评分", "type": "integer", "notify_doctor_condition": "MNA-SF总分<7分或NRS2002>=3分或STRONkids>=1分"},
        {"id": "aspiration_risk_score", "label": "误吸风险评分", "type": "integer", "notify_doctor_condition": "SSA总分>=19分"}
      ],
      "notify_doctor_field": {"id": "notify_doctor", "type": "boolean", "options": ["是", "否"]}
    },
    {
      "id": "nursing_focus",
      "title": "护理重点",
      "field_groups": [
        {"id": "basic_nursing", "label": "基础护理", "options": ["皮肤护理", "协助进餐", "协助如厕", "口腔护理", "及时更换汗湿衣服", "保持床单整洁", "卧床休息", "协助翻身", "其他"]},
        {"id": "specialty_nursing", "label": "专科护理", "options": ["疼痛护理", "约束护理", "PICC护理", "造口护理", "伤口护理", "脐部护理", "血糖监测", "排痰护理", "其他管道护理", "动静脉瘘护理", "高热护理", "脑科观察", "预防VTE护理", "其他"]},
        {"id": "patient_safety", "label": "患者安全", "options": ["防压疮", "防跌倒", "防烫伤", "使用约束带", "防自伤", "防自杀", "防走失", "其他"]},
        {"id": "handover_focus", "label": "护理交接班重点", "options": ["神志", "血压", "心率/脉搏变化", "监测血糖变化", "出血情况", "用药反应", "皮肤情况", "管道情况", "监测体重", "出入量", "情绪和心理", "特殊隔离措施", "其他"]},
        {"id": "family_attention", "label": "提醒患者及家属予以关注", "options": ["饮食配合", "关心、安慰", "留陪护", "其他"]},
        {"id": "admission_notice", "label": "住院告知", "options": ["住院须知（包括环境、制度、物品管理、作息、探陪、订餐等）", "介绍主管医生及主管护士", "无烟医院", "优质护理服务病房", "消防安全", "其他"]}
      ]
    }
  ],
  "signature_fields": ["record_time", "responsible_nurse_signature"],
  "review_notes": [
    "该PDF为扫描图片版，结构化内容来自页面渲染后的人工视觉转录，需重点审批。",
    "入院评估单引用多种量表结果，但本身不是单一计分量表。",
    "部分字段允许多选还是单选需结合业务系统录入习惯复核。"
  ]
}
