      {"id": "friction_shear", "label": "摩擦和剪切力", "options": [{"score": 1, "label": "有问题"}, {"score": 2, "label": "有潜在问题"}, {"score": 3, "label": "无明显问题"}]}
    ]
  },
  "risk_level": {
