      {"id": "moisture", "label": "潮湿", "options": [{"score": 1, "label": "持续潮湿"}, {"score": 2, "label": "非常潮湿"}, {"score": 3, "label": "偶尔潮湿"}, {"score": 4, "label": "很少潮湿"}]},
