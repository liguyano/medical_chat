# 复制为 .env.production，并替换所有 CHANGE_ME 值。
# 密码建议使用只包含字母、数字、点、短横线和下划线的随机字符串，
# 以避免 Redis URL 和 Compose 插值发生转义问题。

PUBLIC_ORIGIN=https://YOUR_DOMAIN
IMAGE_TAG=latest
API_BIND_PORT=18000
FRONTEND_BIND_PORT=13000
NEXT_PUBLIC_API_TIMEOUT_MS=15000

POSTGRES_DB=medical_evaluate
POSTGRES_USER=medical
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

REDIS_APP_PASSWORD=CHANGE_ME_REDIS_APP_PASSWORD
REDIS_CELERY_PASSWORD=CHANGE_ME_REDIS_CELERY_PASSWORD
REDIS_APP_MAXMEMORY=512mb
REDIS_CELERY_MAXMEMORY=512mb

PATIENT_IDENTITY_SECRET=CHANGE_ME_LONG_RANDOM_IDENTITY_SECRET
DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
